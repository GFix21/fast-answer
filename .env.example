# Flow admin password (required for /flow). NFC-normalized at compare time.
# Set in Vercel project env — do not commit real values.
FLOW_PASSWORD=

# Optional: force Secure cookies locally when testing over HTTPS
# FLOW_COOKIE_SECURE=1

# Durable rooms, profiles, and scores. Required on Vercel.
# FAST_ANSWER_REDIS_KV_REST_API_URL=
# FAST_ANSWER_REDIS_KV_REST_API_TOKEN=

# Welcome letters are sent by GMG Brand, not this app.
# On Vercel, set GMAIL_PASSWORD on the GMGbrand project (Gmail app password).
# Same secret on both projects (16+ characters) lets Flow copy this list across.
# LIST_SYNC_SECRET=
# GMG_LIST_ORIGIN=https://gmgbrand.vercel.app
# Set GMG_LIST_ORIGIN=off only to keep the old local Gmail sender.

