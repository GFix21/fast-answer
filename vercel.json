{
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/directions",
      "destination": "/directions.html"
    },
    {
      "source": "/directions/",
      "destination": "/directions.html"
    },
    {
      "source": "/dojo",
      "destination": "/dojo.html"
    },
    {
      "source": "/dojo/",
      "destination": "/dojo.html"
    },
    {
      "source": "/flow",
      "destination": "/flow/index.html"
    },
    {
      "source": "/flow/",
      "destination": "/flow/index.html"
    }
  ]
}
